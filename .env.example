# ── Turso (libsql) ────────────────────────────────────────────────────────
# Create a DB:  turso db create insulin-resistance-app
# URL:          turso db show insulin-resistance-app --url
# Token:        turso db tokens create insulin-resistance-app
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# ── NextAuth ──────────────────────────────────────────────────────────────
# Dev uses port 3001 (3000 often taken). Prod = the Vercel URL.
NEXTAUTH_URL=http://localhost:3001
# Generate:  openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Blood marker encryption (Phase 2.7) ───────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: never rotate without a re-encryption migration — old rows become
# unreadable. Treat as permanent unless you intentionally re-key.
ENCRYPTION_KEY=

# ── Rate limiting (Phase 2.7) ─────────────────────────────────────────────
# Optional — unset means rate-limit checks bypass (local dev / preview).
# Create at https://console.upstash.com → Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web push (Phase 2.7) ──────────────────────────────────────────────────
# Generate:  npx web-push generate-vapid-keys
# Subject MUST be a mailto: URL (RFC 8292).
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Vercel Cron auth (Phase 2.7) ──────────────────────────────────────────
# Random shared secret; Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`.
# Generate:  openssl rand -base64 32
CRON_SECRET=
